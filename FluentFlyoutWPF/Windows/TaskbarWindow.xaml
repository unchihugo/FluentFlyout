<Window x:Class="FluentFlyout.Windows.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FluentFlyout.Windows"
        xmlns:controls="clr-namespace:FluentFlyout.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="TaskbarWindow" Height="200" Width="4000"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{Binding FontFamily}"
        FlowDirection="{Binding FlowDirection}"
        Loaded="Window_Loaded" Visibility="Collapsed" d:Visibility="Visible"
        xmlns:viewModels="clr-namespace:FluentFlyoutWPF.ViewModels"
		d:DataContext="{d:DesignInstance viewModels:UserSettings}">
    <Canvas Name="WidgetCanvas" Background="Transparent">
        <StackPanel x:Name="QuickActionsPanel" Orientation="Horizontal" VerticalAlignment="Center" Panel.ZIndex="10">
            <Border x:Name="MixerButton"
                    Width="36" Height="36" Margin="0,0,4,0"
                    CornerRadius="6"
                    Cursor="Hand"
                    Visibility="{Binding TaskbarMixerButtonEnabled, Converter={StaticResource BoolToVisibleCollapsedConverter}}"
                    ToolTip="{DynamicResource TaskbarMixerButtonTitle}"
                    MouseEnter="QuickAction_MouseEnter"
                    MouseLeave="QuickAction_MouseLeave"
                    PreviewMouseLeftButtonUp="MixerButton_Click"
                    PreviewMouseWheel="MixerButton_PreviewMouseWheel">
                <Border.Background>
                    <SolidColorBrush Color="#01FFFFFF" />
                </Border.Background>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TaskbarUtilityButtonsOutlineEnabled}" Value="True">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ui:SymbolIcon Symbol="SpeakerSettings24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
            <Border x:Name="ClipboardButton"
                    Width="36" Height="36" Margin="0,0,4,0"
                    CornerRadius="6"
                    Cursor="Hand"
                    Visibility="{Binding TaskbarClipboardButtonEnabled, Converter={StaticResource BoolToVisibleCollapsedConverter}}"
                    ToolTip="{DynamicResource TaskbarClipboardButtonTitle}"
                    MouseEnter="QuickAction_MouseEnter"
                    MouseLeave="QuickAction_MouseLeave"
                    PreviewMouseLeftButtonUp="ClipboardButton_Click">
                <Border.Background>
                    <SolidColorBrush Color="#01FFFFFF" />
                </Border.Background>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TaskbarUtilityButtonsOutlineEnabled}" Value="True">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ui:SymbolIcon Symbol="ClipboardClock24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
        </StackPanel>
		<controls:TaskbarVisualizerControl x:Name="TaskbarVisualizer" Margin="0,1,0,0" />
        <controls:TaskbarWidgetControl x:Name="Widget" Visibility="Collapsed" />
    </Canvas>
</Window>
