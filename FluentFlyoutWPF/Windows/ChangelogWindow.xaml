<ui:FluentWindow x:Class="FluentFlyoutWPF.Windows.ChangelogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Width="1000" Height="720" MinWidth="760" MinHeight="500"
    Title="{DynamicResource ChangelogWindowTitle}"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextFormattingMode="Ideal"
    FontFamily="{Binding FontFamily}"
    FlowDirection="{Binding FlowDirection}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="ChangelogWindow_Loaded"
    Closed="ChangelogWindow_Closed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{DynamicResource ChangelogWindowTitle}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/FluentFlyout2.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#33808080" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="{DynamicResource ChangelogAllUpdatesTitle}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        Margin="8,4,8,10" />

                    <ListBox
                        x:Name="ReleaseNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="ReleaseNavigation_SelectionChanged"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Text="{Binding NavigationTitle}"
                                            FontSize="13"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding ReleaseDate}"
                                            FontSize="11"
                                            Opacity="0.6"
                                            Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Background="#0078D4"
                                        CornerRadius="4"
                                        Padding="5,2"
                                        Margin="8,1,0,0"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibleCollapsedConverter}}">
                                        <TextBlock
                                            Text="NEW"
                                            Foreground="White"
                                            FontSize="9"
                                            FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        x:Name="ViewAllFooter"
                        Grid.Row="2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="4,8,4,0"
                        Padding="0,8,0,0"
                        Visibility="Collapsed">
                        <Button
                            x:Name="ViewAllButton"
                            Click="ViewAllButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,8"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock
                                    Text="{DynamicResource ChangelogViewAllUpdatesButton}"
                                    FontSize="13" />
                                <TextBlock
                                    Text="↗"
                                    FontSize="15"
                                    Margin="6,0,0,0"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <WebBrowser
                    x:Name="ReleaseContentBrowser"
                    Visibility="Collapsed"
                    Navigating="ReleaseContentBrowser_Navigating" />

                <StackPanel
                    x:Name="StatusPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24">
                    <TextBlock
                        x:Name="StatusText"
                        Text="{DynamicResource ChangelogLoadingText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Opacity="0.75"
                        MaxWidth="420" />
                    <Button
                        x:Name="OpenOnlineButton"
                        Content="{DynamicResource ChangelogOpenOnlineButton}"
                        Click="OpenOnlineButton_Click"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
