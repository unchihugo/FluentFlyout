<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="TitleText">වෙනස්කම්</system:String>
    <system:String x:Key="TaskbarWidgetAdaptiveWidthTitle">අනුවර්තී විජට් පළල</system:String>
    <system:String x:Key="TaskbarWidgetAdaptiveWidthDescription">කාර්ය තීරුවේ ප්‍රමාණවත් ඉඩක් නොමැති විට විජට් එක ස්වයංක්‍රීයව කුඩා කරන හෝ වැදගත් නොවන අංග බිඳ දමයි</system:String>
